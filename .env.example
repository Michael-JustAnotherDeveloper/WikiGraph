# ─── Backend ──────────────────────────────────────────────────────────────
BACKEND_PORT=8080
# Обязательна. Токен для POST /internal/pages (заголовок X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token-change-me
# Верхняя граница глубины обхода графа. Жёсткий потолок в коде — 5.
GRAPH_MAX_K=5
# Origin фронтенда для CORS. "*" годится только для локальной разработки.
CORS_ORIGIN=*

# ─── Elasticsearch ────────────────────────────────────────────────────────
ES_URL=http://localhost:9200
ES_INDEX=wiki_pages
# Пустые значения = security выключена (локальный docker-compose).
ES_USERNAME=
ES_PASSWORD=

# ─── Neo4j ────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Обязательна.
NEO4J_PASSWORD=neo4j_password

# ─── S3 (Selectel; локально — MinIO) ──────────────────────────────────────
# Обязательны: S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY.
# Для MinIO из docker-compose: S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=https://s3.selcdn.ru
S3_REGION=ru-1
S3_BUCKET=wiki-content
S3_ACCESS_KEY=test_access_key
S3_SECRET_KEY=test_secret_key
# TTL presigned-ссылки, формат time.ParseDuration: 15m, 1h, 30s.
S3_PRESIGNED_TTL=15m

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_BASE=/api